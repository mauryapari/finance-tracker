# Redis key used to store data. Use different values for local dev vs prod
# to avoid overwriting production data during development.
NUXT_PUBLIC_STORAGE_KEY=finance_tracker_data

# Optional — set these to enable Upstash Redis cloud sync.
# Leave unset to use localStorage only.
# Get these from your Upstash console: https://console.upstash.com
NUXT_UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
NUXT_UPSTASH_REDIS_REST_TOKEN=your-token-here

# Required for owner login. Without these the /api/auth/login endpoint
# returns 500, so leave unset only on forks / local dev without auth.
AUTH_PASSWORD=your_secure_password
AUTH_SECRET=random_hex_string_32_chars_or_more
